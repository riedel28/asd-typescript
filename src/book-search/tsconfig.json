    "rootDir": "./src",
    "outDir": "./dist",
    "target": "esnext",
    "lib": [
      "esnext",
      "dom"
    ],
    "types": [],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true
